# =============================================================================
# 结构验证专用 Dockerfile（**不是现场交付路径**）
#
# 目的：在没有 h20-inference:v1.0、没有 55 GB Qwen 权重、没有 1.3 GB bge 权重
# 的开发机上，验证"镜像结构 + 应用装配 + /api/health 可用"这三件事。
#
# 与 Dockerfile（现场路径）的区别：
#   * 基础镜像换成 python:3.11-slim —— 与现场一致的是 Python 版本，不是 CUDA/torch；
#   * 依赖从网络源安装 —— 现场镜像必须用 requirements.lock.txt + wheels/ 离线安装；
#   * 不包含向量模型与知识库 —— 因此运行期 `/api/health` 会如实报告 degraded，
#     这恰好验证了"依赖缺失时不崩溃、如实降级"这条要求。
#
# 用法：
#   docker build -f deploy/onsite-h20/Dockerfile.structural -t spear-onsite-structural .
#   docker run --rm -p 16006:6006 spear-onsite-structural
#   curl -s http://127.0.0.1:16006/api/health
# =============================================================================
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONPATH=/app/cluster-engine/src:/app \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HOME=/tmp/hf_home \
    TOKENIZERS_PARALLELISM=false \
    MODELS_DIR=/app/cluster-engine/models \
    EMBED_MODEL_PATH=/app/cluster-engine/models/bge-large-zh-v1.5 \
    LLM_MODEL_PATH=/app/cluster-engine/models/Qwen3.8-27B \
    OUT_DIR=/app/output \
    PORT=6006 \
    DEVICE=cpu

WORKDIR /app

# 只装"不装就连 import 都过不去"的运行期依赖；torch/chromadb/sentence-transformers
# 刻意不装，用来验证它们缺失时的降级路径。
RUN pip install --no-cache-dir \
        "numpy>=1.24" "scikit-learn>=1.3" "optuna>=3.0" tqdm \
        "fastapi>=0.115" "uvicorn>=0.30" "pydantic>=2.7" "pydantic-settings>=2.3" \
        python-multipart jieba

COPY backend/python/cluster-engine /app/cluster-engine
COPY backend/python/app /app/app
COPY deploy/onsite-h20/app_entry.py /app/app_entry.py
COPY deploy/onsite-h20/web-dist/ /app/web/

RUN mkdir -p /app/output /app/artifacts

HEALTHCHECK --interval=30s --timeout=6s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:6006/api/health', timeout=5).status==200 else 1)"

EXPOSE 6006

CMD ["python", "-m", "uvicorn", "app_entry:app", "--host", "0.0.0.0", "--port", "6006"]
